// Luna Calendar API — Prisma schema.
//
// Uses SQLite for local/dev (see .env.example). SQLite has no native JSON
// column type in Prisma, so structured fields (recurrence rule, attendees,
// reminders, OAuth scope list) are stored as JSON-encoded `String` columns
// (named with a `Json` suffix) and are serialized/deserialized at the
// application boundary (see src/lib/json.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  displayName     String
  avatarUrl       String?
  timeZone        String   @default("Asia/Ho_Chi_Minh")
  calendarDisplay String   @default("both") // "lunar" | "solar" | "both"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts CalendarAccount[]
  events   Event[]
  contacts Contact[]
}

model CalendarAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "lark"
  providerAccountId String
  displayName       String
  avatarUrl         String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  // JSON-encoded string[] of OAuth scopes.
  scopeJson         String   @default("[]")
  // Provider calendar id events get pushed to (e.g. Google "primary", a Lark calendar_id).
  targetCalendarId  String?
  lastSyncedAt      DateTime?
  connectedAt       DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances EventInstance[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
}

model Event {
  id                  String   @id @default(cuid())
  ownerId             String
  title               String
  description         String?
  location            String?
  // ISO 8601 timestamp, or "YYYY-MM-DD" when allDay is true.
  startAt             String
  endAt               String
  allDay              Boolean  @default(false)
  timeZone            String
  color               String?
  // JSON-encoded EventAttendee[] / Reminder[] / RecurrenceRule.
  attendeesJson        String?
  remindersJson        String?
  recurrenceJson       String?
  recurrenceParentId  String?
  // Where this event lives / is synced to. "local" = app-only, not pushed out.
  provider            String   @default("local")
  providerEventId     String?
  providerCalendarId  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  instances EventInstance[]

  @@index([ownerId])
}

// Maps one expanded occurrence of a (possibly recurring) local Event to the
// concrete event the sync engine created on a given provider, so re-syncing
// an already-expanded lunar/solar occurrence updates that provider event
// instead of duplicating it.
model EventInstance {
  id               String   @id @default(cuid())
  parentEventId    String
  // Calendar date (midnight UTC) of this occurrence, in the event's own time zone terms.
  occurrenceDate   DateTime
  provider         String
  providerEventId  String
  accountId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentEvent Event           @relation(fields: [parentEventId], references: [id], onDelete: Cascade)
  account     CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([parentEventId, occurrenceDate, provider])
  @@index([accountId])
}

model Contact {
  id                String   @id @default(cuid())
  ownerId           String
  provider          String
  providerContactId String
  displayName       String
  email             String?
  avatarUrl         String?
  lastSyncedAt      DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, provider, providerContactId])
  @@index([ownerId])
}
