# Copy to .env and fill in real values. Never commit the real .env file.

# SQLite file used by Prisma for local/dev.
DATABASE_URL="file:./dev.db"

# Secret used to sign app session JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials).
# Enable the "Google Calendar API" and "People API" for the project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Lark / Feishu Open Platform app (https://open.feishu.cn/app).
# Needs the "Calendar" and "Contact" scopes on the app's permission page.
LARK_APP_ID=""
LARK_APP_SECRET=""
LARK_REDIRECT_URI="http://localhost:4000/api/auth/lark/callback"

PORT=4000
NODE_ENV=development
